<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/priceCheckFragment">

    <fragment
        android:id="@+id/priceCheckFragment"
        android:name="ke.pricecheck.app.ui.PriceCheckFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_priceCheckFragment_to_watchlistFragment"
            app:destination="@id/watchlistFragment" />
        <action
            android:id="@+id/action_priceCheckFragment_to_storeHandoffFragment"
            app:destination="@id/storeHandoffFragment" />
    </fragment>

    <fragment
        android:id="@+id/watchlistFragment"
        android:name="ke.pricecheck.app.ui.WatchlistFragment"
        android:label="@string/watchlist_title" />

    <fragment
        android:id="@+id/storeHandoffFragment"
        android:name="ke.pricecheck.app.ui.StoreHandoffFragment"
        android:label="@string/store_handoff_title">
        <argument
            android:name="storeName"
            app:argType="string" />
        <action
            android:id="@+id/action_storeHandoffFragment_to_checkoutFragment"
            app:destination="@id/checkoutFragment" />
    </fragment>

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="ke.pricecheck.app.ui.CheckoutFragment"
        android:label="@string/checkout_title">
        <argument
            android:name="storeName"
            app:argType="string" />
        <!-- popUpTo home: after placing an order, Back from status should not return to checkout. -->
        <action
            android:id="@+id/action_checkoutFragment_to_orderStatusFragment"
            app:destination="@id/orderStatusFragment"
            app:popUpTo="@id/priceCheckFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/orderStatusFragment"
        android:name="ke.pricecheck.app.ui.OrderStatusFragment"
        android:label="@string/order_status_title">
        <argument
            android:name="orderId"
            app:argType="string" />
        <argument
            android:name="storeName"
            app:argType="string" />
    </fragment>

    <activity
        android:id="@+id/aboutActivity"
        android:name="ke.pricecheck.app.AboutActivity"
        android:label="@string/about_title" />

    <action
        android:id="@+id/action_global_aboutActivity"
        app:destination="@id/aboutActivity" />
</navigation>
